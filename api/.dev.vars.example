# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# In deployed environments set secrets with `wrangler secret put <NAME>` and
# non-secret values in wrangler.jsonc `vars`.

# --- Auth (Worker-issued sessions) ---
# HS256 key of our access tokens (use `openssl rand -base64 48`).
AUTH_JWT_SECRET=placeholder-long-random-string-at-least-32-chars
# Google OAuth client id(s) accepted as the ID token audience, comma-separated.
GOOGLE_WEB_CLIENT_ID=placeholder.apps.googleusercontent.com

# --- Parse model (DeepSeek) ---
DEEPSEEK_API_KEY=placeholder
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_PARSE_FALLBACK=deepseek:deepseek-v4-flash,deepseek:deepseek-chat
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.1

# --- Workers AI (voice + receipt OCR; the `AI` binding needs no key) ---
WORKERS_AI_WHISPER_MODEL=@cf/openai/whisper-large-v3-turbo
WORKERS_AI_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# 10,000 neurons/day are free (whole account) and billed above: the app stops uploads at this many (UTC day).
AI_DAILY_NEURON_CAP=8000
AI_USER_DAILY_RECEIPTS=10
AI_USER_DAILY_VOICE=10
# Optional AI Gateway (leave empty to skip). DeepSeek is routed through it only when CF_ACCOUNT_ID is also set.
AI_GATEWAY_ID=
CF_ACCOUNT_ID=

# --- Agent (bounded tool-calling loop, see docs/rewrite/agent-v2.md) ---
AGENT_ENABLED=true
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_MODEL_FALLBACK=deepseek-v4-pro
AGENT_MAX_STEPS=4
AGENT_TURN_TIMEOUT_SECONDS=25
AGENT_LLM_TIMEOUT_SECONDS=12
AGENT_DAILY_TOKEN_BUDGET=200000
AGENT_DAILY_QUESTIONS=5
# HMAC key of the conversation-memory token (use `openssl rand -base64 32`). Without it follow-up memory is off.
AGENT_MEMORY_SECRET=placeholder-long-random-string

# --- Predictive engine labeller (nightly DeepSeek call per user; docs/PREDICTIVE-ENGINE-PLAN.md section 7) ---
ENGINE_LLM_ENABLED=true
# Tokens (prompt + completion) the labeller may use per UTC day across all users; beyond it the forecast uses its templates.
ENGINE_DAILY_TOKEN_BUDGET=2000000
# ENGINE_MODEL=deepseek-v4-flash   # defaults to AGENT_MODEL

# --- Uploads and media ---
MAX_RECEIPT_UPLOAD_BYTES=10485760
MAX_VOICE_UPLOAD_BYTES=15728640
# HMAC key of signed /media links for receipts and voice (use `openssl rand -base64 48`). Without it those links are null.
MEDIA_URL_SECRET=placeholder-long-random-string-at-least-32-chars
SIGNED_URL_TTL_SECONDS=21600
AVATAR_URL_ALLOWED_HOSTS=api.dicebear.com

# --- CORS: comma-separated origins; empty = no CORS headers (mobile app needs none) ---
CORS_ORIGINS=

# --- Email (Brevo). Missing BREVO_API_KEY = log and skip send ---
BREVO_API_KEY=
EMAIL_FROM=Dime <hello@localhost>
EMAIL_UNSUBSCRIBE_SECRET=placeholder-long-random-string
EMAIL_APP_LINK=https://play.google.com/store
EMAIL_CRON_SECRET=placeholder-long-random-string
EMAIL_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Optional override; default is the Worker's own /email/* static assets
EMAIL_ASSET_BASE_URL=
FAVQS_API_KEY=
