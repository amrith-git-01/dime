{"id":"g100","turns":[{"question":"How many different payees did I pay in June 2026?","tools":["run_sql"],"alt_tools":[["top_payees"]],"facts":[{"v":26,"k":"count"}],"plan":[{"tool":"run_sql","args":{"query":"SELECT COUNT(DISTINCT counterparty_normalized) AS payees FROM transactions WHERE type = 'debit' AND deleted_at IS NULL AND transaction_at >= '2026-05-31T18:30:00Z' AND transaction_at < '2026-06-30T18:30:00Z'"}}]}]}
{"id":"g101","turns":[{"question":"What was my average expense amount in July 2026?","tools":["run_sql"],"facts":[{"v":1050.69,"k":"money"}],"plan":[{"tool":"run_sql","args":{"query":"SELECT ROUND(AVG(amount), 2) AS average FROM transactions WHERE type = 'debit' AND deleted_at IS NULL AND transaction_at >= '2026-06-30T18:30:00Z' AND transaction_at < '2026-07-31T18:30:00Z'"}}],"note":"no tool computes an average: the fallback is the right choice (the numeric check allows a 1 rupee rounding difference)"}]}
{"id":"g102","turns":[{"question":"On which weekday do I spend the most overall between April and September 2026, and how much in total?","tools":["run_sql"],"facts":[{"v":74118,"k":"money"}],"plan":[{"tool":"run_sql","args":{"query":"SELECT EXTRACT(dow FROM transaction_at AT TIME ZONE 'Asia/Kolkata') AS dow, SUM(amount) AS total FROM transactions WHERE type = 'debit' AND deleted_at IS NULL AND transaction_at >= '2026-03-31T18:30:00Z' AND transaction_at < '2026-09-30T18:30:00Z' GROUP BY 1 ORDER BY total DESC LIMIT 1"}}],"note":"the weekday is Wednesday"}]}
