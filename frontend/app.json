{
  "expo": {
    "name": "Dime",
    "slug": "frontend",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dime",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAFAFA",
    "newArchEnabled": true,
    "androidStatusBar": {
      "translucent": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "allowBackup": false,
      "minSdkVersion": 26,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA",
        "foregroundImage": "./assets/images/icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.amrith_01.frontend",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "dime"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-system-ui",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-wordmark.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAFAFA",
          "dark": {
            "backgroundColor": "#121214",
            "image": "./assets/images/splash-wordmark-dark.png"
          },
          "ios": {
            "imageWidth": 300
          },
          "android": {
            "imageWidth": 168
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dime can read photos you pick for receipts and expense attachments.",
          "cameraPermission": "Dime uses the camera to scan receipts and capture expense details."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dime uses the microphone to capture spoken expenses and add them for you."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Dime",
              "label": "Dime",
              "description": "Your month at a glance with quick add, scan and voice",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "previewImage": "./assets/widgets/dime-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "4eb5ecd2-9c33-4790-b5e8-3d31ca83dbf8"
      }
    },
    "owner": "amrith_01",
    "updates": {
      "url": "https://dime-api.selvarajamrith958.workers.dev/api/v1/updates/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "codeSigningCertificate": "./certs/certificate.pem",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
