# Dime API base URL: the ORIGIN only, with no path and no trailing slash. The app appends /api/v1/... itself.
# Baked into the app at build time (Expo inlines EXPO_PUBLIC_*): rebuild after changing it.
#
# Release / preview builds (HTTPS only): the Cloudflare Worker, e.g.
#   https://dime-api.<your-subdomain>.workers.dev   (or your custom domain, https://api.example.com)
#   Staging Worker: https://dime-api-staging.<your-subdomain>.workers.dev
# For EAS builds set it in the EAS environment instead of this file (see api/DEPLOY.md, "Frontend / EAS").
#
# Local development only (cleartext http is allowed in dev builds, see app.config.js):
#   wrangler dev (api/):  http://127.0.0.1:8787   (Android emulator: rewritten to 10.0.2.2 automatically)
#   physical device:      http://<your PC LAN IP>:8787 and run `npx wrangler dev --ip 0.0.0.0` in api/
#   USB only:             http://127.0.0.1:8787 and `adb reverse tcp:8787 tcp:8787`
EXPO_PUBLIC_API_BASE_URL=
# Dev only: artificial delay (ms) before each API request — skeleton QA on device. Restart Metro after change.
# EXPO_PUBLIC_API_DELAY_MS=2500
# Web OAuth 2.0 Client ID (Google Cloud). The idToken is issued for it, so it must be listed in the API's GOOGLE_WEB_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
