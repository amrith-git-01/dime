EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# FastAPI base URL — baked into release APK at build time (rebuild after changes).
# Physical device + EAS preview APK: use your PC LAN IP (ipconfig → IPv4), not localhost.
# Example: http://192.168.1.10:8000 — phone and PC on same Wi‑Fi; backend on 0.0.0.0:8000.
# USB-only testing with 127.0.0.1: run `adb reverse tcp:8000 tcp:8000` before opening the app.
EXPO_PUBLIC_API_BASE_URL=
# Dev only: artificial delay (ms) before each API request — skeleton QA on device. Restart Metro after change.
# EXPO_PUBLIC_API_DELAY_MS=2500
# Web OAuth 2.0 Client ID (same as in Supabase / Google Cloud — used by native Google Sign-In for idToken)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Android SMS auto-capture — enabled by default for dev builds (set false for Play Store APKs without SMS).
# EXPO_PUBLIC_INCLUDE_SENSITIVE_SMS=false
# Optional override for email confirmation deep link (default: frontend://auth/callback)
# EXPO_PUBLIC_AUTH_REDIRECT_URL=
