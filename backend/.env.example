# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# DeepSeek V4 Flash — structured transaction parse (SMS, receipt OCR text, voice transcript)
DEEPSEEK_API_KEY=
AI_BASE_URL=https://api.deepseek.com/chat/completions
AI_MODEL=deepseek-v4-flash
AI_PARSE_FALLBACK=deepseek:deepseek-v4-flash,deepseek:deepseek-chat
AI_TIMEOUT_SECONDS=45
AI_TEMPERATURE=0.1

# Groq — preprocess only (not final JSON parse)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_PRIMARY=whisper-large-v3-turbo
GROQ_WHISPER_FALLBACK=whisper-large-v3
GROQ_VISION_OCR_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# API listen
API_LISTEN_HOST=0.0.0.0
API_LISTEN_PORT=8000

# Agent (LangGraph)
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash
AGENT_MODEL_FALLBACK=deepseek-v4-pro
AGENT_THINKING_ENABLED=false
AGENT_STRICT_TOOLS=true
AGENT_MAX_TOOL_ROUNDS=5
AGENT_TIMEOUT_SECONDS=45
AGENT_CONTEXT_MAX_MESSAGES=20
AGENT_SQL_TIMEOUT_SECONDS=10
AGENT_SQL_MAX_ROWS=500

# Agent SQL pool
AGENT_SQL_POOL_MIN=2
AGENT_SQL_POOL_MAX=10

# Capture workers
SMS_WORKER_COUNT=2

# Database (direct Postgres for agent SQL)
DATABASE_URL=